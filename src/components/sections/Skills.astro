---
import Section from "./Section.astro";
import { getI18N } from "../../i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<Section id="skills" title={i18n.skills.title} description={i18n.skills.description}>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
            i18n.skills.groups.map((group) => (
                <article class="rounded-xl border border-border-weak bg-surface/60 p-5 transition-colors hover:border-primary/60">
                    <h3 class="font-semibold text-primary">{group.name}</h3>
                    <ul class="mt-4 flex flex-wrap gap-2">
                        {group.items.map((skill) => (
                            <li class="rounded-md bg-surface-2 px-3 py-1 text-sm text-fg-muted transition-colors hover:text-primary">
                                {skill}
                            </li>
                        ))}
                    </ul>
                </article>
            ))
        }
    </div>
</Section>
