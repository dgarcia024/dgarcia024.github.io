---
interface Props {
    id: string;
    title: string;
    description?: string;
    class?: string;
}

const { id, title, description, class: className } = Astro.props;
---

<section
    id={id}
    class:list={[
        "relative flex flex-col justify-center scroll-mt-8 px-5 py-16 md:px-20",
        className
    ]}
>
    <header class="mb-8 max-w-2xl">
        <h2 class="text-2xl font-bold text-balance md:text-3xl">{title}</h2>
        <div aria-hidden="true" class="mt-4 h-px w-24 bg-linear-to-r from-primary to-transparent"></div>
        {description && <p class="mt-4 text-pretty leading-8 text-fg-muted sm:max-w-[82%]">{description}</p>}
    </header>

    <slot />
</section>
