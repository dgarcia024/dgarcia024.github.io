---
// Componente de Fondo de Partículas con Canvas Nativo
---

<div id="particles-container" class="absolute inset-0 z-[-5] pointer-events-none overflow-hidden">
    <canvas id="particles-canvas"></canvas>
</div>

<script>
    function initCanvasParticles() {
        const canvas = document.getElementById("particles-canvas") as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let animationFrameId: number;
        let width = (canvas.width = canvas.offsetWidth);
        let height = (canvas.height = canvas.offsetHeight);

        // Redimensionar el canvas si cambia el tamaño de la ventana
        const handleResize = () => {
            if (!canvas) return;
            width = canvas.width = canvas.offsetWidth;
            height = canvas.height = canvas.offsetHeight;
        };
        window.addEventListener("resize", handleResize);

        // Definición de las partículas
        class Particle {
            x: number;
            y: number;
            size: number;
            speedX: number;
            speedY: number;
            color: string;
            alpha: number;
            maxAlpha: number;
            decay: number;

            constructor(colors: string[]) {
                // Nacen en un área central/inferior o aleatoria
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 2 + 1; // Tamaño entre 1px y 3px
                this.speedX = (Math.random() - 0.3) * 1.2; // Movimiento horizontal suave
                this.speedY = -Math.random() * 1.5 - 0.5;   // Movimiento hacia arriba

                // Colores tomados del tema global (src/styles/global.css)
                this.color = colors[Math.floor(Math.random() * colors.length)];

                this.alpha = 0;
                this.maxAlpha = Math.random() * 0.5 + 0.2; // Opacidad máxima sutil
                this.decay = Math.random() * 0.008 + 0.003; // Velocidad de desvanecimiento
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                // Efecto de aparición y desaparición gradual (Fade in / Fade out)
                if (this.alpha < this.maxAlpha) {
                    this.alpha += this.decay;
                }

                // Si llegan arriba o se vuelven transparentes, se reinician abajo
                if (this.y < 0 || this.alpha <= 0) {
                    this.reset();
                }
            }

            reset() {
                this.x = Math.random() * width;
                this.y = height + 10; // Reinician debajo de la pantalla
                this.alpha = 0;
                this.maxAlpha = Math.random() * 0.5 + 0.2;
                this.speedX = (Math.random() - 0.3) * 1.2;
                this.speedY = -Math.random() * 1.5 - 0.5;
            }

            draw() {
                if (!ctx) return;
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 8;
                ctx.shadowColor = this.color; // Efecto resplandor en cada partícula
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        // Colores del tema global (src/styles/global.css)
        const rootStyles = getComputedStyle(document.documentElement);
        const themeColors = [
            rootStyles.getPropertyValue("--color-primary").trim() || "#14d4c9",
            rootStyles.getPropertyValue("--color-secondary").trim() || "#ff0055",
        ];

        // Crear una cantidad adecuada de partículas
        const particleCount = 50;
        const particles: Particle[] = [];
        for (let i = 0; i < particleCount; i++) {
            const p = new Particle(themeColors);
            // Esparcirlas inicialmente por toda la pantalla para que no aparezcan de golpe
            p.y = Math.random() * height;
            particles.push(p);
        }

        // Bucle de animación
        const animate = () => {
            ctx.clearRect(0, 0, width, height);

            particles.forEach((particle) => {
                particle.update();
                particle.draw();
            });

            animationFrameId = requestAnimationFrame(animate);
        };

        animate();

        // Limpieza al desmontar el componente (útil con View Transitions de Astro)
        return () => {
            window.removeEventListener("resize", handleResize);
            cancelAnimationFrame(animationFrameId);
        };
    }

    // Evita bucles de animación duplicados: astro:page-load y DOMContentLoaded
    // pueden disparar la inicialización más de una vez (p. ej. con View Transitions).
    let cleanup: (() => void) | undefined;

    function start() {
        cleanup?.();
        cleanup = initCanvasParticles();
    }

    // Ejecutar al cargar la página
    document.addEventListener("DOMContentLoaded", start);
    document.addEventListener("astro:page-load", start);
</script>

<style>
    #particles-container {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>