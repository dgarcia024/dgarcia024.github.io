---
import { Image } from "astro:assets";
import profile from "../assets/avatar.png";
import Header from "./Header.astro";
---

<section id="home" class="container">
    <Header />
    <div class="flex flex-col gap-4 md:flex-row">
        <div class="grow p-4">
            <Image
                src={profile}
                alt="Daniel García"
                class="rounded-full w-80 m-auto"
            />
        </div>
    </div>
</section>

<style>
    img {
        border: 1px solid #14d4c9;
        box-shadow: 0 0 10px #14d4c9;
        transition: 0.1s;
    }

    img:hover {
        transform: scale(1.5rem);
        box-shadow:
            0 0 25px #14d4c9,
            0 0 50px #14d4c9;
    }
</style>
