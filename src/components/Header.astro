---
import { getI18N } from "../i18n";
const { currentLocale } = Astro;
const i18n = getI18N({currentLocale})
---
<main class="w-full flex justify-around items-center py-3">
    <nav class="flex flex-row gap-x-8">
        <a href="/">{i18n.nav.home}</a>
        <a href="#">{i18n.nav.about}</a>
        <a href="/">{i18n.nav.experience}</a>
        <a href="/">{i18n.nav.projects}</a>
    </nav>
</main>
